# Grafana Credentials & Settings
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_secure_password
GRAFANA_PORT=3000

# Prometheus Settings
PROMETHEUS_PORT=9090

# Optional: Render Cloud Deploy Hook
# Obtain from Render Dashboard -> Service -> Settings -> Deploy Hook
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-xxxxxxxxxxxx?key=yyyyyyyyyyyy
